{
  "name": "@deadlinerstudio/cli",
  "version": "0.2.0",
  "description": "Agent-native Deadliner task management and WebDAV sync powered by DeadlinerCore",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeadlinerStudio/DeadlinerCli.git"
  },
  "homepage": "https://github.com/DeadlinerStudio/DeadlinerCli#readme",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "bin": {
    "deadliner": "bin/deadliner"
  },
  "files": [
    "bin/deadliner",
    "bin/deadliner-serve",
    "server/",
    "core-revision.txt",
    "src/",
    "scripts/",
    "docs/",
    "tests/integration.py",
    "core-package.lock.json"
  ],
  "scripts": {
    "build": "node scripts/python.cjs scripts/core_package.py cli bin --lock core-package.lock.json",
    "test": "node scripts/python.cjs tests/integration.py",
    "prepack": "node scripts/check-package.cjs",
    "build:source": "sh scripts/build.sh",
    "postinstall": "sh scripts/enable-macos-autostart.sh --global-install"
  }
}
